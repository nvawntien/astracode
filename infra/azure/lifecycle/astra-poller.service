[Unit]
Description=AstraCode protected poller service
After=astra-k3s.service network-online.target
PartOf=astra-k3s.service
ConditionPathExists=/etc/astracode/poller.json
ConditionPathExists=/usr/local/libexec/astra/app/host_services.py

[Service]
User=astra-poller
RuntimeDirectory=astra-poller
RuntimeDirectoryMode=0755
UMask=0077
Environment=PGSERVICEFILE=/etc/astracode/fencer-pg-service.conf
ExecStart=/usr/bin/python3 -B /usr/local/libexec/astra/app/host_services.py poller
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=astra-k3s.service
