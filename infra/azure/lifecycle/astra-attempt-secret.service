[Unit]
Description=Deliver the active database migration credential
After=astra-k3s.service
PartOf=astra-k3s.service

[Service]
User=astra-secret-loader
RuntimeDirectory=astra-attempt
RuntimeDirectoryMode=0755
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/libexec/astra/attempt_secret.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=astra-k3s.service
