{
  "name": "astracode-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "format:check:tooling": "prettier --check .prettierrc.json eslint.config.mjs vitest.config.mjs tests package.json"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.21",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.4.0",
    "prettier": "3.10.1",
    "typescript": "^5.7.2",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
